# Begin - Install DCV Server
function Install-DCVServer {

    if (-not (Get-Service -Name "dcvserver" -ErrorAction SilentlyContinue)) {
        Log-Info -Message "Installing DCVServer from {{ context.get("/system/dcv/windows/url") }}"

        # Check and install Visual C++ prerequisite through the shared downloader
        # so China deployments can supply an S3 mirror and checksum in Parameters.
        $InstalledSoftware = (Get-ItemProperty -Path HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*) | Where-Object {$_.DisplayName -like "Microsoft Visual C++ 2022*"}
        if($InstalledSoftware.count -eq 0) {
            $VcRedistUrl = "{{ context.get("/system/dcv/windows/vc_redist_url") }}"
            $VcRedistSha = "{{ context.get("/system/dcv/windows/vc_redist_sha256", "") }}"
            $VcRedistPath = "$EDHBootstrapAssetsFolder\vc_redist_64.exe"
            Log-Info -Message "Microsoft Visual C++ 2022 not found, installing from $VcRedistUrl"
            Invoke-SOCAFileDownload -DownloadUrl $VcRedistUrl -SaveAs $VcRedistPath -Sha256Checksum $VcRedistSha
            & $VcRedistPath /install /passive /norestart
        }

        # Download Package(s). The DCV URL may be a pipe-delimited
        # "s3://mirror|https://fallback" value when resources_mirroring is
        # enabled; Invoke-SOCAFileDownload parses it and verifies the sha256.
        Invoke-SOCAFileDownload -DownloadUrl "{{ context.get("/system/dcv/windows/url") }}" -SaveAs "$EDHBootstrapAssetsFolder\DCVServer.msi" -Sha256Checksum "{{ context.get("/system/dcv/windows/sha256") }}"

        # Install DCV with all packages
        Start-Process "msiexec.exe" -ArgumentList "/i $EDHBootstrapAssetsFolder\DCVServer.msi ADDLOCAL=ALL /qn /norestart /l*v dcv_install_msi.log" -Wait

        while (-not(Get-Service dcvserver -ErrorAction SilentlyContinue)) { Start-Sleep -Milliseconds 250 }

        # dcvserver will be automatically started after reboot
        Set-Service -Name "dcvserver" -StartupType Automatic
        Log-Info -Message "DCV installed successfully"

    } else {
        Log-Info -Message "DCV is already installed on this machine, skipping DCV install ..."
    }


}
Install-DCVServer